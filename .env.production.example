# Executive Admin — production settings for https://ea.bishnoi.ai
# Set these in Coolify → (this resource) → Environment Variables. Never commit real values.

# ---------------------------------------------------------------- required

# The Coolify database resource's "Postgres URL (internal)", e.g.
# postgres://postgres:<password>@<database-id>:5432/postgres
DATABASE_URL=

# The first Admin, created on the first start when no Admin can sign in yet.
# They must choose a new password on first sign-in; this one then stops working.
# After that first sign-in you may clear BOOTSTRAP_ADMIN_PASSWORD (it is never used again
# while an Admin with a password exists).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Executive Admin
# At least 10 characters, not the email address.
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------- defaults (change only if needed)

# Public address. Writes (POST/PUT/PATCH/DELETE) are only accepted from this origin.
PUBLIC_ORIGIN=https://ea.bishnoi.ai

# Signed out after this many hours without activity, and after this many days in any case.
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=14

# Largest upload (documents and photos), in MB.
MAX_UPLOAD_MB=10

# Seconds between automatic SLA escalation checks.
ESCALATION_INTERVAL_S=300

# ---------------------------------------------------------------- not needed yet
# Email notifications (Zoho SMTP from this server) and One Admin single sign-on are Phase 3;
# their settings will be added here when built. Notifications are in-app until then.
